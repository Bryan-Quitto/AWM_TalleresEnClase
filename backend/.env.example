# ==============================================================
# Backend Gestión Académica — variables de entorno
# Copia este archivo a .env y completa los valores reales.
# .env NO se commitea (ya está en .gitignore).
# ==============================================================

# Puerto HTTP del backend
PORT=3000

# JWT — clave para firmar tokens. Usa un valor aleatorio largo en producción.
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-larga-en-produccion
JWT_EXPIRES_IN=8h

# Firebase Admin SDK
# service account descargado desde Firebase Console.
GOOGLE_APPLICATION_CREDENTIALS=apuntar-a-ruta-del-json